# Base URL of the Laravel API (browser calls this directly for Sanctum
# cookie-based SPA auth — see .claude/API.md and .claude/SECURITY.md).
# Not a secret: this is just a hostname the browser needs to know.
NEXT_PUBLIC_API_URL=

# This frontend's own public origin (must match backend/.env's
# FRONTEND_URL). Used to build the quick-add link/QR code shown in
# Settings (reviewengine.com/quick/{token} in production).
NEXT_PUBLIC_APP_URL=


# Settings' "Connect with your other tools" links (zapier-integration/,
# Step 5's Make.com equivalent). Left blank until each is actually live —
# set once published, not before; see IntegrationLinksSection.tsx.
NEXT_PUBLIC_ZAPIER_LISTING_URL=
NEXT_PUBLIC_MAKE_LISTING_URL=

# Paddle's overlay checkout (SubscribeForm.tsx) runs Paddle.js in the
# browser — these are the only Paddle config the frontend needs, and all
# of them are meant to be public by Paddle's own design, unlike
# backend/.env's PADDLE_AUTH_CODE/PADDLE_WEBHOOK_SECRET (real secrets,
# server-side only, .claude/SECURITY.md #5). Must match the backend's
# PADDLE_CLIENT_SIDE_TOKEN/PADDLE_SANDBOX exactly — a sandbox client-side
# token against Paddle.Environment.set('production') (or vice versa)
# fails the checkout outright. Read this from Paddle's sandbox dashboard
# under Developer Tools -> Authentication (sandbox-vendors.paddle.com) —
# generate a new client-side token there if one doesn't already exist.
# SubscribeForm.tsx throws (not a silent default) if this is unset, so it
# can never accidentally run against live credentials by mistake.
NEXT_PUBLIC_PADDLE_CLIENT_SIDE_TOKEN=
NEXT_PUBLIC_PADDLE_SANDBOX=

# The same two Paddle Price IDs (format pri_...) as backend's
# PADDLE_PRICE_MONTHLY/PADDLE_PRICE_ANNUAL (backend/config/plans.php) —
# from the Paddle dashboard's Monthly/Annual prices under this app's one
# Product. Not secret. Used ONLY for Paddle.PricePreview()'s localized
# price display (lib/plans.ts) — never to decide what gets charged, which
# stays entirely server-side: the frontend only ever sends an
# "monthly"/"annual" interval to POST /subscribe, never a raw price ID
# (.claude/SECURITY.md #1).
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ANNUAL=
