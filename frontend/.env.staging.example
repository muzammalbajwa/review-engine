# Staging defaults. This is a TEMPLATE — copy it to the actual staging
# server/host as .env.production (Next.js reads .env.production for any
# non-development `next build`/`next start`, staging included — there is
# no separate "staging" env-file convention in Next.js itself, unlike the
# backend's own .env.staging.example) and fill in real values there.
# Never commit a filled-in version.

# The real staging backend's own public origin — the browser calls this
# directly. Must be reachable over HTTPS from wherever the staging
# frontend is actually served; not a secret, just a hostname.
NEXT_PUBLIC_API_URL=

# This frontend's own real staging origin — must match backend/.env's
# FRONTEND_URL on staging exactly (scheme+host+port). That match is the
# entire CORS story (backend/config/cors.php reads FRONTEND_URL, no
# wildcards, SECURITY.md #6) — get this wrong and every real API call
# from staging fails a CORS preflight, not silently, but confusingly (a
# generic "Failed to fetch" in the browser console, not an obvious CORS
# error message).
NEXT_PUBLIC_APP_URL=


# Left blank deliberately, same as every other environment right now —
# see IntegrationLinksSection.tsx's own comment. Not a staging-specific
# gap.
NEXT_PUBLIC_ZAPIER_LISTING_URL=
NEXT_PUBLIC_MAKE_LISTING_URL=

# Must match the staging backend's PADDLE_CLIENT_SIDE_TOKEN/PADDLE_SANDBOX
# exactly (backend/.env.staging.example: PADDLE_SANDBOX=true there too —
# staging always runs against Paddle's sandbox, never real money).
NEXT_PUBLIC_PADDLE_CLIENT_SIDE_TOKEN=
NEXT_PUBLIC_PADDLE_SANDBOX=true

# --- Worth checking once the real staging domain is known ---
# If staging sits behind a reverse proxy/CDN/load balancer that changes
# the Host header Next.js sees, Server Actions' own origin-check
# (separate from the CORS config above — this is Next.js's own CSRF
# protection for Server Actions, next.config.ts's
# experimental.serverActions) may need the staging domain added to an
# `allowedOrigins` array there. Not needed for a plain single-server
# staging box; flagged here so it isn't a surprise if the real
# infrastructure turns out to include a proxy.
