# Production defaults. This is a TEMPLATE — copy it on the actual server and
# fill in real values there. Never commit a filled-in version of this file.
# Differs from .env.example mainly in: APP_DEBUG=false, stricter cookies,
# quieter logging. See .claude/SECURITY.md #5 and #6.

APP_NAME=ReviewEngine
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Database (Postgres 16) ---
# Runtime connection: app_user, a non-superuser role that cannot bypass RLS.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Password assigned to app_user by the RLS migration.
DB_APP_USER_PASSWORD=

# Owner/superuser connection — migrations only, never runtime queries.
DB_OWNER_USERNAME=
DB_OWNER_PASSWORD=

# Sanctum SPA auth uses Laravel's session cookie. Locked down per
# .claude/SECURITY.md: httpOnly (framework default), Secure, SameSite=Strict.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database

# --- Redis (queues via Horizon) ---
REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Mail (Resend/Postmark via Laravel Mail) ---
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# --- Stripe / Cashier ---
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE=
LEMON_SQUEEZY_SIGNING_SECRET=
LEMON_SQUEEZY_VARIANT_MONTHLY=
LEMON_SQUEEZY_VARIANT_ANNUAL=

# --- Claude API (compliance checks + review replies) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Google OAuth / Business Profile API ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Frontend / CORS (config/cors.php reads FRONTEND_URL — no wildcards) ---
FRONTEND_URL=
SANCTUM_STATEFUL_DOMAINS=

# --- Ops alerting (.claude/QUEUE.md: worker heartbeat) ---
# A real inbox someone actually watches — this is the "every tenant's
# reviews just silently stopped" alert. Do not leave this blank in production.
OPS_ALERT_EMAIL=
