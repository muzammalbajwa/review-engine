APP_NAME=ReviewEngine
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (Postgres 16) ---
# Runtime connection: app_user, a non-superuser role that cannot bypass RLS.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Password assigned to app_user by the RLS migration.
DB_APP_USER_PASSWORD=

# Owner/superuser connection — migrations only, never runtime queries.
DB_OWNER_USERNAME=
DB_OWNER_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

# --- Redis (queues via Horizon) ---
REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Mail (Resend/Postmark via Laravel Mail) ---
MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# config/services.php only ever reads RESEND_API_KEY — this was
# previously named RESEND_KEY here, a real mismatch that would silently
# leave the resend mailer unauthenticated for anyone who filled in the
# wrong-named var exactly as this file showed it.
RESEND_API_KEY=
POSTMARK_API_KEY=

# --- Paddle (laravel/cashier-paddle) ---
# PADDLE_SANDBOX=true against Paddle's sandbox environment/credentials —
# never real live keys in local dev (same "never real live credentials,
# never real money" rule .claude/CLAUDE.md golden rule #6 already applied
# to every prior processor here). PADDLE_AUTH_CODE is what
# config/cashier.php actually reads first (falls back to PADDLE_API_KEY
# if unset) — named for Paddle's own "API key"/"Auth code" terminology,
# not carried over from Stripe's or Lemon Squeezy's naming.
PADDLE_SANDBOX=true
PADDLE_SELLER_ID=
PADDLE_AUTH_CODE=
PADDLE_CLIENT_SIDE_TOKEN=
PADDLE_WEBHOOK_SECRET=

# --- Claude API (compliance checks + review replies) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Google OAuth / Business Profile API ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Frontend / CORS ---
FRONTEND_URL=
SANCTUM_STATEFUL_DOMAINS=

# --- Ops alerting (.claude/QUEUE.md: worker heartbeat) ---
# Where queue:check-heartbeat emails if Horizon's master supervisor goes
# silent. Blank is safe (the check still logs critical either way) but
# means nobody gets paged — set this before going live.
OPS_ALERT_EMAIL=

VITE_APP_NAME="${APP_NAME}"
