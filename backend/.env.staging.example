# Staging defaults. This is a TEMPLATE — copy it to the actual staging
# server as .env and fill in the real values there. Never commit a
# filled-in version of this file (matches .env.production.example's own
# rule, .claude/SECURITY.md #5: "All secrets in .env. .env is gitignored.").
#
# Differs from .env.production.example in exactly three places, each
# called out below: APP_ENV (staging, not production — this is what
# config/horizon.php's environments map now keys off; see that file's own
# comment for the live-reproduced silent-zero-workers bug this guards
# against), LOG_LEVEL (debug, not error — staging exists to be watched
# closely while verifying real infrastructure, quiet logging works against
# that), and LEMON_SQUEEZY_API_KEY/LEMON_SQUEEZY_VARIANT_* (test-mode
# values — a test-mode API key only ever interacts with test-mode store
# data, per Lemon Squeezy's own test-mode design, same "never real live
# credentials, never real money" rule .claude/CLAUDE.md golden rule #6
# already applied to Stripe).

APP_NAME=ReviewEngine
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# debug, not production's error — staging is being actively watched
# during verification, not run quietly. Turn this down once staging
# settles into routine use.
LOG_LEVEL=debug

# --- Database (Postgres 16) ---
# Runtime connection: app_user, a non-superuser role that cannot bypass
# RLS (.claude/DATABASE.md). This must be a REAL, separate staging
# database — never point staging at the production database "just to
# save provisioning a second one." A staging bug that writes bad data is
# exactly the failure mode staging exists to catch safely.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Password assigned to app_user by the RLS-enabling migration
# (2026_07_17_145636_enable_row_level_security.php) — set here BEFORE
# running migrations for the first time; that migration reads this value
# to create the role and refuses to run if it's blank.
DB_APP_USER_PASSWORD=

# Owner/superuser connection — migrations only, never a runtime query.
DB_OWNER_USERNAME=
DB_OWNER_PASSWORD=

# httpOnly (framework default), Secure, SameSite=Strict — SECURITY.md #3.
# Staging is real HTTPS infrastructure, not local dev, so these stay
# exactly as strict as production's own values.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database

# --- Redis (queues via Horizon) ---
# Must be a real, reachable Redis instance for Horizon to actually
# process anything — config/horizon.php's 'staging' environment entry
# provisions 3 processes here, same shape as local dev, deliberately not
# production's 10 (staging is a correctness check, not a load target).
REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Mail (Resend/Postmark via Laravel Mail) ---
# A REAL mailer, not Mailpit — this is the whole point of staging
# verification item #2 (a real email delivered through Resend/Postmark).
# Postmark works too; config/services.php already reads POSTMARK_API_KEY
# if MAIL_MAILER=postmark instead.
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# --- Stripe / Cashier ---
# TEST-MODE keys only (sk_test_/pk_test_) — see the file header. Get the
# webhook signing secret from the Stripe Dashboard's own webhook endpoint
# configuration for this staging URL specifically, not reused from
# another environment's endpoint (each registered endpoint gets its own
# secret).
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE=
LEMON_SQUEEZY_SIGNING_SECRET=
LEMON_SQUEEZY_VARIANT_MONTHLY=
LEMON_SQUEEZY_VARIANT_ANNUAL=

# --- Claude API (compliance checks + review replies) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Google OAuth / Business Profile API ---
# GOOGLE_REDIRECT_URI must be the exact staging URL registered as an
# authorized redirect URI in the Google Cloud Console for this OAuth
# client — Google rejects the callback outright on any mismatch (path,
# scheme, or trailing slash all count). https://<staging-domain>/api/v1/gbp/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Frontend / CORS (config/cors.php reads FRONTEND_URL — no wildcards,
# SECURITY.md #6) ---
# The real staging frontend origin, exact scheme+host+port, comma-separated
# if ever more than one. This is what "CORS locked to the real staging
# frontend origin" actually means in code — there's no separate CORS
# setting to configure, it's entirely this one value.
FRONTEND_URL=
SANCTUM_STATEFUL_DOMAINS=

# --- Ops alerting (.claude/QUEUE.md: worker heartbeat) ---
# A real inbox someone actually watches — this is verification item #5
# (the heartbeat alert firing for real). Must be a real, checkable
# address, not a placeholder — an alert nobody receives is the same as no
# alert at all.
OPS_ALERT_EMAIL=
