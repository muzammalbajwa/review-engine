# Copy to .env for local development and testing (zapier-platform-core's
# tools.env.inject() loads this automatically — see test/*.test.js).
# Never commit the real .env.

# ReviewEngine's API host — same value as frontend/.env.local's
# NEXT_PUBLIC_API_URL in dev; the tenant's real production host once deployed.
API_BASE_URL=http://127.0.0.1:8123

# Optional — only needed to run the tests in test/ that hit the real API.
# Generate one from Settings -> API keys against a throwaway/test tenant,
# not a real customer account.
TEST_API_KEY=
